{
  "schema_version": 3,
  "candidate_scope": {
    "allowed_prefixes": [
      "development/"
    ],
    "protected_paths": [
      "development/nova-recursive-self-improvement/evaluator.py",
      "development/nova-recursive-self-improvement/rsi_engine.py",
      "development/nova-recursive-self-improvement/rsi_policy.json",
      "development/nova-recursive-self-improvement/candidate.schema.json",
      "development/nova-recursive-self-improvement/tests/",
      ".github/",
      "development/nova-recursive-self-improvement/provider_client.py",
      "development/nova-recursive-self-improvement/preflight.py",
      "development/nova-recursive-self-improvement/CAPABILITY-BENCHMARK-PROTOCOL.md",
      "development/nova-recursive-self-improvement/benchmarks/",
      "development/nova-recursive-self-improvement/sandbox_runtime.py",
      "development/nova-recursive-self-improvement/README.md",
      "development/nova-recursive-self-improvement/IMPLEMENTATION.md"
    ],
    "forbidden_path_fragments": [
      ".env",
      "credentials",
      "secret",
      "private_key",
      "id_rsa",
      ".git",
      ".gitmodules"
    ]
  },
  "evaluation": {
    "timeout_seconds": 300,
    "require_benchmark": true,
    "benchmark_command_env": "RSI_BENCHMARK_COMMAND",
    "provider_timeout_seconds": 120
  },
  "budget": {
    "max_proposer_calls_per_cycle": 1,
    "max_candidate_attempts_per_cycle": 1,
    "max_context_chars": 24000,
    "max_output_tokens": 1536,
    "max_total_tokens_per_cycle": 8000,
    "require_usage_telemetry": true,
    "max_cycles_per_utc_day": 1
  },
  "promotion": {
    "mode": "candidate-branch",
    "allow_main": false,
    "require_benchmark_pass": true
  },
  "implementation_readiness": {
    "status": "INCOMPLETE",
    "require_explicit_ready": true,
    "promotion_blocked_until_ready": true,
    "note": "The RSI subsystem remains implementation-gated until the protected benchmark, independent evaluation checks, and runtime verification are complete. This status must not be changed by candidate code."
  },
  "candidate_limits": {
    "max_patch_chars": 120000,
    "max_patch_lines": 5000,
    "max_patch_files": 20
  },
  "context": {
    "excluded_prefixes": [
      "development/verification/archive/",
      "development/verification/evidence/",
      "backup/"
    ],
    "priority_prefixes": [
      "development/nova-recursive-self-improvement/",
      "development/nova-ai-orchestration/",
      "development/nova-context-memory-optimization/",
      "development/gpu-infrastructure/",
      "development/ai-media-generator/",
      "development/Prompt-Guide.md",
      "development/DEVELOPMENT-AND-AUDIT-CONVENTION.md",
      "development/SECURITY-BASELINE.md",
      "development/README.md"
    ]
  },
  "provider": {
    "api_key_env": "NOSANA_LLM_API_KEY_01",
    "base_url_env": "RSI_AI_BASE_URL",
    "model_env": "RSI_AI_MODEL",
    "max_response_bytes": 262144,
    "default_base_url": "https://inference.nosana.com/v1"
  },
  "sandbox": {
    "runtime": "docker",
    "image": "python@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258",
    "expected_image_id": "sha256:4f228bc1cbcfc794e4878312cfc241d368eff55a21c08d1e2bb263116c4ef524",
    "platform": "linux/amd64",
    "max_output_bytes": 32000,
    "max_output_file_bytes": 67108864,
    "max_open_files": 256,
    "max_cpu_seconds": 120,
    "max_memory": "2g",
    "max_cpus": "2",
    "max_pids": 128,
    "tmpfs_size": "128m"
  }
}
