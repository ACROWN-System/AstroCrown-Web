{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astrocrown-account-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat", "webcrypto_modern_algorithms"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acrown-account-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "RP_NAME": "AstroCrown",
    "RP_ID": "localhost",
    "EXPECTED_ORIGIN": "http://localhost:8787"
  },
  "env": {
    "staging": {
      "name": "astrocrown-account-staging-staging",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "RP_NAME": "AstroCrown",
        "RP_ID": "SET_BEFORE_DEPLOY",
        "EXPECTED_ORIGIN": "https://SET_BEFORE_DEPLOY.invalid"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "acrown-account-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
