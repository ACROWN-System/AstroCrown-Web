{
  "name": "astrocrown-account-staging-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "node scripts/build-staging-site.mjs",
    "check:worker": "wrangler deploy --dry-run --outdir=./.wrangler-out",
    "check": "npm run build:site && npm run check:worker",
    "test": "node --test tests/*.test.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "viem": "2.57.14"
  },
  "devDependencies": {
    "wrangler": "4.156.2"
  }
}
